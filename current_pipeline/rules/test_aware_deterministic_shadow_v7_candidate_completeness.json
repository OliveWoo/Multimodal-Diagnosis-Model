{
  "schema_version": "7.0.0",
  "policy_id": "test_aware_deterministic_shadow_v7_candidate_completeness",
  "mode": "answer_blind_candidate_completeness_shadow",
  "rank_bands": {
    "top": 1,
    "strong": 3,
    "moderate": 10
  },
  "taxonomy_contract": {
    "identity_resolution_field": "taxonomy_identity_resolution",
    "routing_source_field": "taxonomy_rule_source",
    "identity_and_clinical_family_are_separate": true,
    "resistance_phenotype_is_not_inferred_from_species_name": true
  },
  "context_rescue": {
    "single_test_rank_at_most": 3,
    "reproducible_rank_at_most": 10
  },
  "missingness_context_rescue": {
    "enabled": true,
    "families": [
      "typical_respiratory_pathogen",
      "hospital_or_nonfermenter_gnb",
      "high_consequence_opportunistic",
      "mold_or_opportunistic_fungus"
    ],
    "excluded_mapping_statuses": ["unmapped", "rejected"],
    "minimum_missing_axes": 1,
    "maximum_result": "review_context_needed"
  },
  "opportunistic_safety_net_forwarding": {
    "enabled": true,
    "families": ["high_consequence_opportunistic"],
    "accepted_mapping_statuses": ["exact_species"],
    "compatible_specimen_contexts": [
      "lower_respiratory",
      "blood_or_systemic",
      "sterile_or_systemic"
    ],
    "require_host_support": false,
    "maximum_result": "review_context_needed"
  },
  "hospital_only_context_forwarding": {
    "enabled": true,
    "accepted_levels": ["Level 4"],
    "excluded_taxonomy_families": [
      "unmapped_or_uncertain",
      "commensal_virome_or_endogenous_element"
    ],
    "maximum_result": "review_context_needed",
    "require_canonical_positive_hospital_evidence": true
  },
  "clinical_scorer_forwarding": {
    "include_decisions": [
      "picked_shadow",
      "review_high_priority",
      "review_context_needed"
    ]
  },
  "analytical_pick_families": [
    "typical_respiratory_pathogen",
    "hospital_or_nonfermenter_gnb"
  ],
  "direct_pick_families": [
    "typical_respiratory_pathogen",
    "hospital_or_nonfermenter_gnb",
    "other_respiratory_virus"
  ],
  "opportunistic_families": [
    "high_consequence_opportunistic",
    "mold_or_opportunistic_fungus"
  ],
  "context_only_families": [
    "candida_or_yeast",
    "herpes_or_reactivation_virus",
    "oral_aspiration_or_anaerobe",
    "skin_airway_colonizer_prone"
  ],
  "low_specificity_families": [
    "environmental_low_specificity",
    "gi_urinary_or_nonpulmonary_prone",
    "commensal_virome_or_endogenous_element",
    "unmapped_or_uncertain"
  ],
  "low_specificity_repeat_high": {
    "enabled": true,
    "families": [
      "environmental_low_specificity",
      "skin_airway_colonizer_prone"
    ],
    "required_mapping_status": "exact_species",
    "required_specimen_context": "lower_respiratory",
    "minimum_selected_branches": 2,
    "require_no_cross_molecule": true,
    "minimum_per_branch_rpm": 10.0,
    "accepted_qc_statuses": ["evaluable", "partial_evaluable"],
    "excluded_repeat_group_types": ["explicit_original_library_rerun"],
    "maximum_result": "review_high_priority"
  },
  "constraints": [
    "Positive reads are required; detected=true with reads=0 cannot create an mNGS candidate.",
    "Missing evidence is unknown rather than negative evidence.",
    "Canonical positive Level 4 hospital evidence may create Context only; it cannot create High or Picked.",
    "Unmapped taxonomy remains Audit-only and cannot enter patient Context.",
    "Raw reads, RPM, and ranks remain attached to individual seq_id tests and are never summed across tests.",
    "Technical repeats are analytical reproducibility, not independent clinical confirmations.",
    "No patient is forced to have a Picked candidate.",
    "The policy is answer blind; benchmark answers are used only by a separate evaluator."
  ]
}
