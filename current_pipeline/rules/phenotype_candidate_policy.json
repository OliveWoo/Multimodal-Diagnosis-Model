{
  "schema_version": "phenotype_candidate_policy_v1.0",
  "policy_version": "phenotype_candidate_shadow_v1.1",
  "description": "Answer-blind routing from organism taxonomy families to clinically relevant pneumonia phenotypes.",
  "global_constraints": [
    "Keep a compact overview of all 22 phenotypes for every candidate.",
    "Taxonomy routing selects which phenotype evidence is expanded; it never removes the full overview.",
    "Phenotype evidence cannot create a candidate or directly change deterministic Picked.",
    "Only QC-passed medium/high-confidence YES evidence from PRE_PNEUMONIA or AT_ONSET may act as an etiologic prior.",
    "NO means not established and is not negative evidence.",
    "AFTER_ONSET is outcome or context and cannot establish etiology.",
    "Severity phenotypes do not identify a pathogen.",
    "Direct organism evidence remains separate from phenotype context."
  ],
