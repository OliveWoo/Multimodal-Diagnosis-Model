  "thresholds": {
    "bacterial_reproducible_max_rank": 3,
    "direct_supported_max_rank": 10,
    "opportunistic_max_rank": 10,
    "environmental_max_rank": 3,
    "minimum_reproduced_tests": 2
  },
  "constraints": [
    "This is an answer-blind development shadow and does not overwrite frozen promotion v4-v7.",
    "All v4-v7 promotion routes remain unchanged and are evaluated before the v8 respiratory-virus group-convergence route.",
    "The v8 route requires an explicitly approved group/member identity relationship; genus or fuzzy text similarity is insufficient.",
    "Exact species identity comes from mNGS. The broad FilmArray target remains group-level support and is never represented as exact subtype confirmation.",
    "The exact mNGS member must be top three in at least one positive test from a compatible lower-respiratory event.",
    "The group assay must be positive, lower-respiratory, Level 1-2, and within plus or minus 48 hours of the mNGS event.",
    "When the route passes, the broad hospital-only identity remains audit-visible but is not reported as a duplicate pathogen.",
    "Missing timing or missing identity mapping is unknown and does not satisfy the positive route.",
    "Reads and RPM remain per-test evidence and are never summed across tests.",
    "Benchmark answers are used only after answer-blind outputs are frozen."
  ]
}
